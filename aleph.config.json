{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/aleph.json",
      "destination": "/aleph.config.json"
    },
    {
      "source": "/aleph.config.json",
      "destination": "/aleph.config.json"
    }
  ]
}